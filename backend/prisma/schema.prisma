datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  CREATOR
  BRAND
}

enum PlatformType {
  YOUTUBE
  INSTAGRAM
}

enum AccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  RECOMMENDED
  VIEWED
  ACCEPTED
  DECLINED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum CollaborationStatus {
  PROPOSED
  NEGOTIATING
  AGREED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  role      UserRole
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  creator   Creator?
  brand     Brand?
  messages  Message[]

  @@map("users")
}

model Creator {
  id                 String                  @id @default(uuid())
  userId             String                  @unique @map("user_id")
  displayName        String                  @map("display_name")
  bio                String?
  location           String?
  contactInformation Json?                   @map("contact_information")
  profileImageUrl    String?                 @map("profile_image_url")
  preferences        Json?
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts     SocialAccount[]
  metricSnapshots    CreatorMetricSnapshot[]
  contents           Content[]
  aiProfile          CreatorAIProfile?
  matches            Match[]
  applications       Application[]
  collaborations     Collaboration[]
  conversations      Conversation[]

  @@map("creators")
}

model Brand {
  id                 String          @id @default(uuid())
  userId             String          @unique @map("user_id")
  name               String
  description        String?
  category           String?
  targetMarkets      String[]        @default([]) @map("target_markets")
  website            String?
  contactInformation Json?           @map("contact_information")
  preferences        Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns          Campaign[]
  collaborations     Collaboration[]
  conversations      Conversation[]

  @@map("brands")
}

model SocialAccount {
  id                     String                  @id @default(uuid())
  creatorId              String                  @map("creator_id")
  platform               PlatformType
  platformAccountId      String                  @map("platform_account_id")
  username               String
  authorizationReference String?                 @map("authorization_reference")
  status                 AccountStatus           @default(CONNECTED)
  connectedAt            DateTime                @default(now()) @map("connected_at")
  lastSyncedAt           DateTime?               @map("last_synced_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  creator                Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  metricSnapshots        CreatorMetricSnapshot[]
  contents               Content[]

  @@unique([platform, platformAccountId])
  @@map("social_accounts")
}

model CreatorMetricSnapshot {
  id               String         @id @default(uuid())
  creatorId        String         @map("creator_id")
  socialAccountId  String?        @map("social_account_id")
  followers        Int?
  following        Int?
  totalViews       BigInt?        @map("total_views")
  averageViews     Float?         @map("average_views")
  engagementRate   Float?         @map("engagement_rate")
  postingFrequency Float?         @map("posting_frequency")
  source           String?
  recordedAt       DateTime       @default(now()) @map("recorded_at")

  creator          Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([creatorId, recordedAt])
  @@map("creator_metric_snapshots")
}

model Content {
  id                String              @id @default(uuid())
  creatorId         String              @map("creator_id")
  socialAccountId   String?             @map("social_account_id")
  platform          PlatformType
  platformContentId String              @map("platform_content_id")
  title             String?
  description       String?
  caption           String?
  permalink         String?
  contentType       String?             @map("content_type")
  publishedAt       DateTime?           @map("published_at")
  views             BigInt?
  likes             Int?
  comments          Int?
  shares            Int?
  fetchedAt         DateTime            @default(now()) @map("fetched_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  creator           Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  aiAnalysis        ContentAIAnalysis?

  @@unique([platform, platformContentId])
  @@index([creatorId, publishedAt])
  @@map("contents")
}

model ContentAIAnalysis {
  id                   String    @id @default(uuid())
  contentId            String    @unique @map("content_id")
  topics               String[]  @default([])
  niche                String?
  style                String?
  commercialCategories String[]  @default([]) @map("commercial_categories")
  confidence           Float?
  analyzedAt           DateTime  @default(now()) @map("analyzed_at")

  content              Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("content_ai_analyses")
}

model CreatorAIProfile {
  id                    String                       @id @default(uuid())
  creatorId             String                       @unique @map("creator_id")
  primaryNiches         String[]                     @default([]) @map("primary_niches")
  secondaryNiches       String[]                     @default([]) @map("secondary_niches")
  contentStyle          String[]                     @default([]) @map("content_style")
  audienceSummary       String?                      @map("audience_summary")
  audienceInterests     String[]                     @default([]) @map("audience_interests")
  commercialCategories  String[]                     @default([]) @map("commercial_categories")
  brandSuitability      Json?                        @map("brand_suitability")
  opportunityCategories String[]                     @default([]) @map("opportunity_categories")
  confidenceData        Json?                        @map("confidence_data")
  embedding             Unsupported("vector(768)")?
  modelVersion          String?                      @map("model_version")
  generatedAt           DateTime                     @default(now()) @map("generated_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  creator               Creator                      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_ai_profiles")
}

model Campaign {
  id                String             @id @default(uuid())
  brandId           String             @map("brand_id")
  title             String
  description       String
  productOrService  String?            @map("product_or_service")
  objective         String?
  targetAudience    Json?              @map("target_audience")
  budgetMin         Decimal?           @map("budget_min") @db.Decimal(12, 2)
  budgetMax         Decimal?           @map("budget_max") @db.Decimal(12, 2)
  requiredReach     Int?               @map("required_reach")
  platform          PlatformType?
  contentType       String?            @map("content_type")
  contentStyle      String?            @map("content_style")
  creatorNiche      String?            @map("creator_niche")
  location          String?
  timeline          Json?
  exclusivity       String?
  usageRights       String?            @map("usage_rights")
  status            CampaignStatus     @default(DRAFT)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  aiProfile         CampaignAIProfile?
  matches           Match[]
  applications      Application[]
  collaborations    Collaboration[]
  conversations     Conversation[]

  @@map("campaigns")
}

model CampaignAIProfile {
  id                     String                       @id @default(uuid())
  campaignId             String                       @unique @map("campaign_id")
  normalizedObjective    String?                      @map("normalized_objective")
  targetAudienceProfile  Json?                        @map("target_audience_profile")
  inferredNiches         String[]                     @default([]) @map("inferred_niches")
  contentRequirements    Json?                        @map("content_requirements")
  commercialCategories   String[]                     @default([]) @map("commercial_categories")
  semanticSummary        String?                      @map("semantic_summary")
  confidenceData         Json?                        @map("confidence_data")
  embedding              Unsupported("vector(768)")?
  modelVersion           String?                      @map("model_version")
  generatedAt            DateTime                     @default(now()) @map("generated_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")

  campaign               Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_ai_profiles")
}

model Match {
  id                       String      @id @default(uuid())
  creatorId                String      @map("creator_id")
  campaignId               String      @map("campaign_id")
  semanticScore            Float?      @map("semantic_score")
  audienceScore            Float?      @map("audience_score")
  performanceScore         Float?      @map("performance_score")
  platformScore            Float?      @map("platform_score")
  requirementsScore        Float?      @map("requirements_score")
  brandCompatibilityScore  Float?      @map("brand_compatibility_score")
  historicalScore          Float?      @map("historical_score")
  finalScore               Float       @map("final_score")
  explanationEvidence      Json?       @map("explanation_evidence")
  explanation              String?
  conflictFlag             Boolean     @default(false) @map("conflict_flag")
  status                   MatchStatus @default(RECOMMENDED)
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  creator                  Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaign                 Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([creatorId, campaignId])
  @@index([finalScore])
  @@map("matches")
}

model Collaboration {
  id             String              @id @default(uuid())
  creatorId      String              @map("creator_id")
  brandId        String              @map("brand_id")
  campaignId     String?             @map("campaign_id")
  conversationId String?             @unique @map("conversation_id")
  agreedAmount   Decimal?            @map("agreed_amount") @db.Decimal(12, 2)
  deliverables   Json?
  usageRights    String?             @map("usage_rights")
  exclusivity    String?
  status         CollaborationStatus @default(PROPOSED)
  startedAt      DateTime?           @map("started_at")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  creator        Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brand          Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign       Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  offers         Offer[]
  payments       Payment[]

  @@map("collaborations")
}

model Conversation {
  id              String         @id @default(uuid())
  creatorId       String         @map("creator_id")
  brandId         String         @map("brand_id")
  campaignId      String?        @map("campaign_id")
  collaborationId String?        @map("collaboration_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  creator         Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  collaboration   Collaboration?
  messages        Message[]
  offers          Offer[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderUserId   String       @map("sender_user_id")
  messageText    String       @map("message_text")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Offer {
  id              String         @id @default(uuid())
  conversationId  String         @map("conversation_id")
  collaborationId String?        @map("collaboration_id")
  senderUserId    String         @map("sender_user_id")
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  deliverables    Json?
  usageRights     String?        @map("usage_rights")
  exclusivity     String?
  status          OfferStatus    @default(PENDING)
  parentOfferId   String?        @map("parent_offer_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  respondedAt     DateTime?      @map("responded_at")

  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  parentOffer     Offer?         @relation("OfferNegotiation", fields: [parentOfferId], references: [id], onDelete: SetNull)
  childOffers     Offer[]        @relation("OfferNegotiation")

  @@map("offers")
}

model Payment {
  id                String          @id @default(uuid())
  collaborationId   String          @map("collaboration_id")
  payerUserId       String          @map("payer_user_id")
  recipientUserId   String          @map("recipient_user_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerPaymentId String?         @map("provider_payment_id")
  providerOrderId   String?         @map("provider_order_id")
  status            PaymentStatus   @default(CREATED)
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  collaboration     Collaboration   @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Application {
  id             String            @id @default(uuid())
  campaignId     String            @map("campaign_id")
  creatorId      String            @map("creator_id")
  pitch          String?
  proposedRate   Decimal?          @map("proposed_rate") @db.Decimal(12, 2)
  status         ApplicationStatus @default(SUBMITTED)
  brandNote      String?           @map("brand_note")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator        Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, campaignId])
  @@index([campaignId, status])
  @@index([creatorId, status])
  @@map("applications")
}

