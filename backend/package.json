{
  "name": "crab-backend",
  "version": "0.1.1",
  "private": true,
  "description": "CRAB Backend API (Node.js, Express, TypeScript, Prisma, Supabase)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:db": "tsx src/scripts/verifyDb.ts",
    "test:auth": "tsx src/scripts/verifyAuth.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "@types/multer": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
