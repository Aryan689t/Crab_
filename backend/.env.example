# ==========================================
# CRAB Backend Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# -------------------------------------------------------------
# Database (Supabase PostgreSQL with pgvector)
# -------------------------------------------------------------
# IMPORTANT: If your database password contains special characters (e.g. '@', ':', '#'),
# they MUST be percent-encoded (e.g., 'Supabase@123' -> 'Supabase%40123').
#
# DATABASE_URL: Transaction Pooler URL (port 6543) with pgbouncer=true
# DIRECT_URL: Direct / Session Pooler URL (port 5432) for Prisma schema migrations
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# -------------------------------------------------------------
# Supabase Authentication & Client Configuration
# -------------------------------------------------------------
# Found in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional backend secret keys (never share or commit to Git):
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# -------------------------------------------------------------
# External Services (Optional for Local Demo & Hackathon MVP)
# -------------------------------------------------------------
# AI Services (Google Gemini API key - BACKEND ONLY, never set on frontend or Vercel)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Social Platform APIs (YouTube & Meta Instagram)
YOUTUBE_API_KEY="your-youtube-api-key"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/social/youtube/callback"

# Meta / Instagram Login for Business & Creators (Official Meta Graph API)
# Register at: https://developers.facebook.com/
INSTAGRAM_APP_ID="your-meta-instagram-app-id"
INSTAGRAM_APP_SECRET="your-meta-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:5000/api/social/instagram/callback"
FRONTEND_URL="http://localhost:3000"
