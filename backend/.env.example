# ==========================================
# CRAB Backend Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL with pgvector)
# Note: Use transaction pooler or direct connection URL from Supabase project settings
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Auth & Storage
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# AI Services
GEMINI_API_KEY="your-gemini-api-key"

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Social Platform APIs (Optional for MVP local dev - mock fallbacks provided)
YOUTUBE_API_KEY="your-youtube-api-key"
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
