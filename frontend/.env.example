# ==========================================
# CRAB Frontend Environment Configuration
# ==========================================

# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Supabase Auth & Client
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
 
# NOTE: DO NOT ADD GEMINI_API_KEY TO VERCEL OR FRONTEND.
# Gemini is executed strictly on the backend Node/Express server.
# Adding secrets here with NEXT_PUBLIC_ would expose them in client browser bundles.
